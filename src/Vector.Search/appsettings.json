{
  "ConnectionStrings": {
    "DatabaseContext": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Information",
      "OpenTelemetry": "Information"
    }
  },
  "AllowedHosts": "*",
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OllamaSettings": {
    "Url": "http://ollama:11434",
    "TimeoutFromMinutes": 10,
    "EmbeddingsContextWindowSize": 8192,
    "ChatContextWindowSize": 8192,
    "Temperature": 0.5,
    "TopP": 0.8
  },
  "QdrantSettings": {
    "Url": "http://qdrant:6334",
    "CollectionName": "persons",
    "TimeoutFromSeconds": 10
  },
  "DetailedErrors": true,
  "SeqSettings": {
    "ServerUrl": "http://seq/ingest/otlp/v1/traces",
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "vector.search"
    }
  }
}
